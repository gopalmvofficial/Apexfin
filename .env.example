# ==============================================================================
# ApexFin Enterprise SaaS Environment Configuration
# ==============================================================================

# Backend API Endpoint
# (Leave empty for default http://127.0.0.1:8000, or point to your live Render/Railway URL)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Real Social OAuth Credentials
# ------------------------------------------------------------------------------
# 1. Google Identity Services (OAuth 2.0 Web Client ID from console.cloud.google.com)
# When set, clicking "Google" opens Google's live account chooser popup dialog.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 2. Sign in with Apple (Service ID & Team ID from developer.apple.com)
NEXT_PUBLIC_APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# 3. GitHub OAuth (Client ID from github.com/settings/developers)
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# ------------------------------------------------------------------------------
# Cryptographic Security Secrets
# ------------------------------------------------------------------------------
JWT_SECRET=apexfin_super_secret_enterprise_key_2026_production
PORT=8000
